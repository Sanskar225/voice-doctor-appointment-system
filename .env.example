# Aurelia Health — Voice AI Doctor Appointment Assistant
# Copy this file to .env and add your keys. Never commit .env to Git.

# Required: ElevenLabs API key (used for Speech-to-Text and Text-to-Speech)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: ElevenLabs voice ID (default: Sarah — premade free-tier compatible)
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Optional: ElevenLabs TTS model (eleven_flash_v2_5 gives ~75ms latency)
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Optional: ElevenLabs STT mode — "realtime" (Scribe v2 WebSocket) or "segmented" (Scribe v2 HTTP + Silero VAD)
ELEVENLABS_STT_MODE=realtime

# Required: Google Gemini API key (free tier available via Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model (default: gemini-3.1-flash-lite for ultra-low voice latency)
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: Set true only if using a Vertex AI Express Mode key
GEMINI_USE_VERTEX=false

# Optional: Server host & port
HOST=0.0.0.0
PORT=8000
